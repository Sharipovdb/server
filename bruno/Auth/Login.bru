meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{adminUsername}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.body.data) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
    bru.setEnvVar("refreshToken", res.body.data.refreshToken);
  }
}
